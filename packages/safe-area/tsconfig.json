{
    "compilerOptions": {
        "target": "ES2015",
        "lib": ["ES2015"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node", "jest"],
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["src", "tests", "tsdown.config.mts"]
}
